# ========================
# Firebase Configuration
# ========================
# Get these from Firebase Console > Project Settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK (Server-side only)
# Get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_SDK_KEY={"type":"service_account","project_id":"your_project_id",...}

# ========================
# AI API Keys
# ========================
# Gemini API Key
# Get from: https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key

# ========================
# Cloudflare Configuration
# ========================
# Get from Cloudflare Dashboard > Pages > Deployments
NEXT_PUBLIC_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
NEXT_PUBLIC_CLOUDFLARE_PROJECT_NAME=tubertify

